# Copy to .env and fill in values
ENVIRONMENT=development
DOCS_ENABLED=true
LOG_LEVEL=INFO
LOG_JSON=true
ADMIN_DIAGNOSTICS_TOKEN=
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/cover_letter
RUN_MIGRATIONS_ON_STARTUP=true
REDIS_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=
CELERY_TASK_ALWAYS_EAGER=false
CELERY_DEFAULT_QUEUE=cover-letter-jobs

# Auth
JWT_SECRET=replace-with-32-byte-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRES_MINUTES=30
REFRESH_TOKEN_EXPIRES_DAYS=14

# CORS (JSON list)
CORS_ORIGINS=["http://localhost:3000"]

# AI providers
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Rate limits (JSON maps by plan)
JOB_ANALYSIS_DAILY_LIMITS={"free":25,"pro":250,"team":1000}
GENERATION_DAILY_LIMITS={"free":10,"pro":100,"team":500}
RATE_LIMIT_WINDOW_SECONDS=86400
